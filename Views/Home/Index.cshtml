@{
    ViewData["Title"] = "Home Page";
}

<section class="titulo">
    <h1>UN DIA COMÚN</h1>
</section>

@{ var usuario = Context.Session.GetString("Nombre"); }
@if (string.IsNullOrEmpty(usuario))
{
    <section class="sectionNoEstilo">
        <button class="button" type="button" onclick="location.href='@Url.Action("Registrarse", "Home")'">Registrarse</button>
        <button class="button" type="button" onclick="location.href='@Url.Action("IniciarSesion", "Home")'">Iniciar</button>
    </section>
}
else
{
    <section class="sectionNoEstilo">
        <button class="button" type="button" id="btnEntrar">Entrar</button>
    </section>

    <div id="modalSalas" class="ventana-fondo">
        <div class="ventana">
            <h2>Selecciona una Sala</h2>
            <div>
                @foreach(int niv in ViewBag.nivel){
                    <a class="button salaBtn" href="@Url.Action("entrar", "Home", new { numero = niv })">@niv</a>
                }
            </div>
        </div>
    </div>
}


<button class="button" type="button" onclick="location.href='@Url.Action("Nosotros", "Home")'">EL EQUIPO</button>