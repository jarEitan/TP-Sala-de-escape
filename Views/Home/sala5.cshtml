@{
    ViewData["Title"] = "sala 5";
}

<section class="inventario" id="inventario">
    <p>Inventario</p>
    <div id="bate" style="display: none;">
        <p>Bate</p>
        <img src="~/imagenes/recursos/bate.png" alt="filtro rojo" class="item" />
        <button class="button" type="button" onclick="usarBate()">Usar</button>
    </div>
</section>

<section class="fondo catacumba-sala5" id="0">
    <img src="~/imagenes/recursos/bate.png" alt="filtro rojo" class="bate" id="bate-item" onclick="agarrarItem('bate-item', 'bate')" />
    <img src="~/imagenes/recursos/smith.png" alt="smith" class="smith1" onclick="abrirModal('smith1')"/>
    <img src="~/imagenes/recursos/smith.png" alt="smith" class="smith2" onclick="abrirModal('smith2')"/>
    
    <div id="smith1" class="ventana-fondo" style="display: none;">
        <div class="ventana texto-org">
            <h2>La izquierda es segura... o eso murmuran las paredes cuando nadie observa</h2>
            <button class="button" type="button" onclick="cerrarModal('smith1')">Salir</button>
        </div>
    </div>
    <div id="smith2" class="ventana-fondo" style="display: none;">
        <div class="ventana texto-org">
            <h2>La derecha es peligroso, entre ecos y grietas donde los pasos se pierden</h2>
            <button class="button" type="button" onclick="cerrarModal('smith2')">Salir</button>
        </div>
    </div>


    <img src="~/imagenes/recursos/papel.png" alt="abajo" class="papel" onclick="abrirModal('text')"/>
    <div id="text" class="ventana-fondo" style="display: none;">
        <div class="ventana texto-org">
            <h2>El papel dice: "uno miente uno dice la verdad"</h2>
            <button class="button" type="button" onclick="cerrarModal('text')">Salir</button>
        </div>
    </div>


    <img src="~/imagenes/recursos/flecha-arriba.png" alt="arriba" class="flechaArriba" id="flecha" onclick="location.href='@Url.Action("entrar", "Home", new { numero = 6 })'" style="display: none;"/>
</section>