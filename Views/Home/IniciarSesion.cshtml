@{
    ViewData["Title"] = "Iniciar sesión";
}

<section>
    <form action='@Url.Action("ValidarCuenta", "Home")' method="post" onsubmit="return validarCuenta();">
        <h1>Iniciar sesión</h1>

        <div>
            <label>Nombre</label>
            <input id="usuario" type="text" name="Nombre" class="input-matrix lil-input" />
        </div>

        <div>
            <label>Contraseña</label>
            <input id="contrasena" type="password" name="Contraseña" class="input-matrix lil-input" />
        </div>
        <p id="mensaje">@ViewBag.Mensaje</p>

        <!-- Cloudflare Turnstile widget - site key proporcionada por el usuario -->
        <div class="auth-form-group">
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAET63HM5pdMTLMTA"></div>
        </div>
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

        <button type="submit" class="button lil-boton">iniciar sesión</button>
        <button type="button" class="button lil-boton" onclick="location.href='@Url.Action("Index", "Home")'">volver</button>
    </form>
</section>